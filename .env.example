# AI Shorts Generator Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM Provider (Required - choose one)
# =============================================================================

# Set which LLM provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic Claude (Recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here


# =============================================================================
# Research Sources (Optional but recommended)
# =============================================================================

# Reddit API (for trending topic research)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# News API (for news headlines)
NEWS_API_KEY=your_news_api_key

# Twitter/X API (future implementation)
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token


# =============================================================================
# Image Sources (Optional)
# =============================================================================

# Pexels API (free stock photos)
PEXELS_API_KEY=your_pexels_api_key

# Unsplash API (alternative stock photos)
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key


# =============================================================================
# Text-to-Speech (Optional)
# =============================================================================

# ElevenLabs (premium TTS - higher quality voices)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Note: Edge TTS is used by default (free, no API key needed)


# =============================================================================
# Configuration
# =============================================================================

# Default video duration (seconds)
DEFAULT_DURATION=45

# Default video style (engaging, dramatic, educational, humorous)
DEFAULT_STYLE=engaging

# Default narrative tone (informative, casual, professional, excited)
DEFAULT_TONE=informative

# Viral potential threshold (0.0-1.0, lower = more topics found)
VIRAL_THRESHOLD=0.4

# Enable Stable Diffusion for image generation (requires GPU for good performance)
# Set to false if you get transformers/diffusers import errors
USE_STABLE_DIFFUSION=false

# Stable Diffusion model path (will auto-download if not present)
SD_MODEL_PATH=runwayml/stable-diffusion-v1-5

# -----------------------------------------------------------------------------
# Optional ASID captioner configuration (requires additional dependencies)
# -----------------------------------------------------------------------------
# You don't need an API key; the model runs locally via Hugging Face.
# ASID_MODEL_ID=AudioVisual-Caption/ASID-Captioner-3B
